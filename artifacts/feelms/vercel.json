{
  "buildCommand": "pnpm --filter @workspace/feelms build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://feelms-movie-site-1.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
